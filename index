    <script>
        /* ---------- 1. IMAGE FALLBACK ---------- */
        function applyImgFallback(img) {
            const label = (img.alt || 'Product').toUpperCase();
            const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
                <rect width="400" height="300" fill="#eef4fb"/>
                <rect x="120" y="80" width="160" height="120" rx="14" fill="#d6e4f5" stroke="#0b3c7c" stroke-width="3"/>
                <rect x="148" y="105" width="70" height="45" rx="6" fill="#0b3c7c" opacity="0.75"/>
                <circle cx="245" cy="175" r="12" fill="#d32f2f"/>
                <text x="200" y="240" font-size="18" font-weight="700" text-anchor="middle"
                      fill="#0b3c7c" font-family="Arial, sans-serif">${label}</text>
            </svg>`;
            img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
        }

        document.querySelectorAll('img').forEach(img => {
            if (img.complete && img.naturalWidth === 0) {
                applyImgFallback(img);
            } else {
                img.addEventListener('error', () => applyImgFallback(img));
            }
        });

        /* ---------- 2. MOBILE MENU ---------- */
        const mobileToggle = document.getElementById('mobileToggle');
        const navLinks = document.getElementById('navLinks');

        mobileToggle.addEventListener('click', () => {
            navLinks.classList.toggle('active');
            const icon = mobileToggle.querySelector('i');
            if (navLinks.classList.contains('active')) {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-times');
            } else {
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
            }
        });

        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('active');
                const icon = mobileToggle.querySelector('i');
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
            });
        });

        /* ---------- 3. SCROLL FADE-IN ---------- */
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.fade-in').forEach(el => {
            observer.observe(el);
        });

        /* ---------- 4. SMOOTH SCROLL ---------- */
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        /* ---------- 5. ENQUIRY FORM -> WHATSAPP ---------- */
        document.getElementById('enqForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const name = document.getElementById('enqName');
            const phone = document.getElementById('enqPhone');
            const nameOk = name.value.trim().length > 1;
            const digits = phone.value.replace(/\D/g, '').replace(/^91(?=\d{10}$)/, '');
            const phoneOk = /^[6-9]\d{9}$/.test(digits);
            name.classList.toggle('invalid', !nameOk);
            phone.classList.toggle('invalid', !phoneOk);
            if (!nameOk || !phoneOk) return;
            const v = id => document.getElementById(id).value.trim();
            const lines = [
                'Hello Sunteck Medical, I would like to enquire.',
                'Name: ' + name.value.trim(),
                'Phone: ' + digits,
                'Equipment/Service: ' + v('enqProduct'),
                'Requirement: ' + v('enqType'),
                v('enqCity') ? 'City: ' + v('enqCity') : '',
                v('enqMsg') ? 'Message: ' + v('enqMsg') : ''
            ].filter(Boolean);
            window.open('https://wa.me/918874618130?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
        });
    </script>

